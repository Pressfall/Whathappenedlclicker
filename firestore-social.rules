// Firestore security rules for the public, player-written collections: leaderboard, global_chat, clan_chat, profiles.
// DRAFT. Read docs/trust-boundaries.md first: what these rules can and cannot do, and what is still open.
//
// WHAT THIS FILE IS
//   The other rules files (firestore-saves.rules, firestore-codes.rules) cover the signed-in, private parts. The social
//   features were never covered by a rules file in this repo, and tools/notes.txt says "CHANGE RULES IN FIREBASE
//   EVENTUALLY", so the rules live only in the Firebase console and may still be test-mode or a catch-all. This file
//   is what those collections should say, written from what the client code actually sends today.
//
// WHAT IT CANNOT DO
//   Players of the social features are NOT signed in: the game picks a username in the browser and writes under it.
//   A rule has no way to tell who is writing, so it cannot stop someone posting a score, a chat message or a profile
//   under another name. These rules only (1) make the leaderboard and chat append-only, (2) check the shape, size and
//   type of what is written, (3) stop deletes of live data, and (4) stamp times with the server's clock. Trusting a
//   score, a clan's points or a reward needs a signed-in writer and a server that checks the number (see the doc).
//
// HOW TO USE
//   Firebase console > Firestore Database > Rules: copy the four `match` blocks and the helper functions below into your
//   rules, inside `match /databases/{database}/documents { ... }`, next to the saves and codes blocks. Keep a copy of your
//   current rules so you can put them back. Then test in the Rules Playground (checklist at the bottom) BEFORE Publish.
//   NOT RUN against the Firestore emulator (it needs Java, which was not available when this was written).
//
// IMPORTANT: Firestore allows a request if ANY matching rule allows it. A catch-all such as
//     match /{document=**} { allow read, write: if true; }
// or a time-limited test-mode rule makes every block below pointless. Remove it, and write a block for each collection
// you use (clans, clans/{id}/members and events are not covered here: see the doc).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- leaderboard: one document per submission (the game writes an 'alltime' and a 'monthly' copy) ----
    // Anyone can read. Anyone can add an entry of the right shape. Nobody can change or delete one.
    match /leaderboard/{id} {
      allow read: if true;
      allow create: if validLeaderboardEntry();
      allow update, delete: if false;
    }

    // ---- global chat ----
    // Messages are append-only. Trimming (the game deletes the oldest when there are too many) is allowed only for messages
    // older than an hour, so a visitor cannot wipe the live conversation.
    match /global_chat/{id} {
      allow read: if true;
      allow create: if validChat(['name', 'message', 'title', 'createdAt', 'scrollToBottom']);
      allow update: if false;
      allow delete: if isOldMessage();
    }

    // ---- clan chat ----
    // Players write {clanId, name, message, title, createdAt, scrollToBottom}; the game also posts SYSTEM lines
    // (joined, left, level up) with system / color flags. Pinning edits only the three pin fields.
    match /clan_chat/{id} {
      allow read: if true;
      allow create: if validChat(['clanId', 'name', 'message', 'title', 'createdAt', 'scrollToBottom', 'system', 'color']) && request.resource.data.clanId is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedBy', 'pinnedByRole'])
        && request.resource.data.pinned is bool;
      allow delete: if isOldMessage();                    // see note 1
    }

    // ---- profiles: one document per username ----
    // Written by the game page (score, Golden, title), the clan page (clanId, clanName, clanRole, kick notice).
    // Anyone can read. A write may only touch known fields, within bounds. Documents are never deleted.
    match /profiles/{username} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(profileFields()) && validProfile(username);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields()) && validProfile(username);
      allow delete: if false;
    }

    // ---- clans: held by Firebase sign-in ids (uid), not by names anyone can type ----
    // The spec is core/clan-roles.js classifyClanUpdate (tested in tests/clan-roles.test.js): these rules say the same.
    // Fields: ownerUid, roles {uid: role}, names {uid: username}, acct {uid: bool (signed in to an account)},
    // kicks {uid: {reason, at}}, act {by, kind, target} (a kick or role change names its target: rules can't pick the
    // changed key out of a set). The old owner / members / leaders lists are still written for older pages.
    // Creating, owning, and being co-leader need an account (not an anonymous sign-in). A clan from before this update has no
    // ownerUid: its owner claims it (signed in, under the old owner name); until then it can't be managed.
    // NOT COVERED: clans/{id}/members (per-member event points) and events/* are still self-reported and open: see
    // docs/trust-boundaries.md. XP and the other shared progress fields are whatever a member's browser says.
    match /clans/{clanId} {
      allow read: if true;
      allow create: if signedIn() && isAccount() && validNewClan();
      allow delete: if signedIn() && claimed(resource.data) && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (claimLegacy() || joinOrLeave() || progress()
        || (claimed(resource.data) && (transfer() || rename() || roleChange() || kick() || manage())));
    }

    // ---------------------------------------------------------------- helpers

    function signedIn() { return request.auth != null; }
    function isAccount() { return request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function claimed(d) { return d.get('ownerUid', '') is string && d.get('ownerUid', '') != ''; }
    function rankOf(r) { return r == 'leader' ? 5 : r == 'co-leader' ? 4 : r == 'elder' ? 3 : r == 'eleite member' ? 2 : r == 'member' ? 1 : 0; }
    function roleIn(d, u) { return d.get('ownerUid', '') == u ? 'leader' : d.get('roles', {}).get(u, ''); }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function mapChanged(field) { return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys(); }
    function memberFields() { return ['clanXp', 'checkin', 'activeBuffs', 'activeBuff', 'buffProgress', 'cpDonated', 'clanShopIconsUnlocked', 'eventXpAwarded']; }
    function manageFields() { return ['description', 'clanIcon', 'clanCustomLogoUrl', 'maxMembers']; }

    function validNewClan() {
      let a = request.resource.data;
      let me = request.auth.uid;
      return a.ownerUid == me && a.roles.keys().size() == 1 && a.roles[me] == 'leader'
        && a.names[me] is string && a.acct[me] == true && a.get('clanXp', 0) == 0;
    }
    // an old clan's owner, signed in to an account, under the old owner name: only ownerUid and their own entry change
    function claimLegacy() {
      let a = request.resource.data;
      let me = request.auth.uid;
      return !claimed(resource.data) && isAccount() && a.ownerUid == me && a.names[me] == resource.data.owner
        && mapChanged('roles') == [me].toSet() && a.roles[me] == 'leader'
        && changedKeys().hasOnly(['ownerUid', 'roles', 'names', 'acct']);
    }
    // my own entry: in as a member (my acct saying what my sign-in really is, room in the clan), or out (not the owner)
    function joinOrLeave() {
      let a = request.resource.data;
      let b = resource.data;
      let me = request.auth.uid;
      let was = b.get('roles', {}).get(me, '');
      let now = a.get('roles', {}).get(me, '');
      return mapChanged('roles') == [me].toSet() && mapChanged('names').hasOnly([me]) && mapChanged('acct').hasOnly([me]) && mapChanged('kicks').size() == 0
        && changedKeys().hasOnly(['roles', 'names', 'acct', 'members', 'leaders'])
        && ((was == '' && now == 'member' && a.names[me] is string && a.get('acct', {}).get(me, false) == isAccount()
              && (!claimed(b) || a.roles.keys().size() <= b.get('maxMembers', 30)))
          || (was != '' && now == '' && b.get('ownerUid', '') != me));
    }
    // shared progress: anyone in a claimed clan; anyone signed in for an old one (as today)
    function progress() {
      return changedKeys().hasOnly(memberFields()) && (!claimed(resource.data) || roleIn(resource.data, request.auth.uid) != '');
    }
    // the owner hands the clan to a member with an account, who becomes leader; the old owner stays as co-leader
    function transfer() {
      let a = request.resource.data;
      let b = resource.data;
      let me = request.auth.uid;
      let to = a.ownerUid;
      return b.ownerUid == me && to != me && b.get('roles', {}).get(to, '') != '' && b.get('acct', {}).get(to, false) == true
        && a.roles[to] == 'leader' && a.roles[me] == 'co-leader' && mapChanged('roles').hasOnly([to, me])
        && changedKeys().hasOnly(['ownerUid', 'roles', 'owner', 'leaders']);
    }
    function rename() { return changedKeys().hasOnly(['name']) && rankOf(roleIn(resource.data, request.auth.uid)) >= 5; }
    function manage() { return changedKeys().hasOnly(manageFields()) && rankOf(roleIn(resource.data, request.auth.uid)) >= 4; }
    // a role change: one member's role, never the owner's, up to just below mine (anything, for the leader); co-leader
    // only for someone with an account
    function roleChange() {
      let a = request.resource.data;
      let b = resource.data;
      let t = a.act.target;
      let mine = rankOf(roleIn(b, request.auth.uid));
      let was = b.get('roles', {}).get(t, '');
      let now = a.get('roles', {}).get(t, '');
      return a.act.by == request.auth.uid && a.act.kind == 'role' && mapChanged('roles') == [t].toSet() && t != b.ownerUid
        && was != '' && rankOf(now) > 0 && now != 'leader'
        && (mine >= 5 || (mine > rankOf(now) && mine > rankOf(was)))
        && (rankOf(now) < 4 || b.get('acct', {}).get(t, false) == true)
        && changedKeys().hasOnly(['roles', 'leaders', 'act']);
    }
    // a kick: one member out (never the owner), by someone of a higher rank (or the leader), with an optional notice
    function kick() {
      let a = request.resource.data;
      let b = resource.data;
      let t = a.act.target;
      let mine = rankOf(roleIn(b, request.auth.uid));
      return a.act.by == request.auth.uid && a.act.kind == 'kick' && mapChanged('roles') == [t].toSet() && t != b.ownerUid
        && b.get('roles', {}).get(t, '') != '' && a.get('roles', {}).get(t, '') == ''
        && mine > 0 && (mine >= 5 || mine > rankOf(b.roles[t]))
        && mapChanged('names').hasOnly([t]) && mapChanged('acct').hasOnly([t]) && mapChanged('kicks').hasOnly([t])
        && changedKeys().hasOnly(['roles', 'names', 'acct', 'kicks', 'members', 'leaders', 'act']);
    }

    function validLeaderboardEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'title', 'score', 'type', 'createdAt'])
        && d.keys().hasAll(['name', 'score', 'type', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 32
        && (!('title' in d) || (d.title is string && d.title.size() <= 64))
        && d.score is number && d.score >= 0              // NaN fails this; there is no upper bound a rule can state portably
        && d.type in ['alltime', 'monthly']
        && d.createdAt == request.time;                    // the server's clock, not the player's
    }

    // `allowed` lists every field a chat message may carry
    function validChat(allowed) {
      let d = request.resource.data;
      return d.keys().hasOnly(allowed)
        && d.keys().hasAll(['name', 'message', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 32
        && d.message is string && d.message.size() > 0 && d.message.size() <= 500
        && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 64))
        && (!('scrollToBottom' in d) || d.scrollToBottom is bool)
        && (!('system' in d) || d.system is bool)
        && (!('color' in d) || (d.color is string && d.color.size() <= 16))
        && d.createdAt == request.time;
    }

    function isOldMessage() {
      return resource.data.createdAt < request.time - duration.value(1, 'h');
    }

    function profileFields() {
      return ['username', 'title', 'score', 'points', 'totalScore', 'golden', 'goldenWhat', 'totalGoldenEver', 'totalGolden',
        'clanPoints', 'updatedAt', 'clanId', 'clanName', 'clanRole', 'kickedMessage', 'kickedAt'];
    }

    // bounds for whichever of the fields are present in the document after the write
    function validProfile(username) {
      let d = request.resource.data;
      return (!('username' in d) || d.username == username)
        && username.size() > 0 && username.size() <= 32
        && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 64))
        && (!('score' in d) || (d.score is number && d.score >= 0))
        && (!('points' in d) || (d.points is number && d.points >= 0))
        && (!('totalScore' in d) || (d.totalScore is number && d.totalScore >= 0))
        && (!('golden' in d) || (d.golden is number && d.golden >= 0))
        && (!('goldenWhat' in d) || (d.goldenWhat is number && d.goldenWhat >= 0))
        && (!('totalGoldenEver' in d) || (d.totalGoldenEver is number && d.totalGoldenEver >= 0))
        && (!('totalGolden' in d) || (d.totalGolden is number && d.totalGolden >= 0))
        && (!('clanPoints' in d) || (d.clanPoints is number && d.clanPoints >= 0))
        && (!('clanId' in d) || d.clanId == null || (d.clanId is string && d.clanId.size() <= 64))
        && (!('clanName' in d) || d.clanName == null || (d.clanName is string && d.clanName.size() <= 64))
        && (!('clanRole' in d) || d.clanRole == null || (d.clanRole is string && d.clanRole.size() <= 20))
        && (!('kickedMessage' in d) || d.kickedMessage == null || (d.kickedMessage is string && d.kickedMessage.size() <= 300));
    }
  }
}

// NOTE 1: the clan page deletes a clan's chat when the clan is disbanded (clan.html, the disband handler) and the game trims the
// oldest messages. Deletes of messages younger than an hour are refused, so a disbanded clan's recent chat lingers until it is
// an hour old, and trimming a very busy chat can be partly refused. Both fail quietly in the client (try / catch).
//
// RULES PLAYGROUND CHECKLIST (do these before publishing; each should ALLOW unless it says DENY)
//   leaderboard create {name:'A', title:'', score: 5000, type:'alltime', createdAt: request.time}      ALLOW
//   leaderboard create with score -1, or type 'x', or an extra field 'admin': true, or name of 33 chars  DENY
//   leaderboard update / delete anything                                                                  DENY
//   global_chat create {name:'A', message:'hi', title:null, createdAt: request.time, scrollToBottom:true} ALLOW
//   global_chat create with a message of 501 characters, or createdAt set to a past time                  DENY
//   global_chat delete of a message created 2 hours ago ALLOW; of one created 1 minute ago                DENY
//   clan_chat create with clanId, then pin: update {pinned:true, pinnedBy:'A', pinnedByRole:'leader'}     ALLOW
//   clan_chat update that changes `message`                                                               DENY
//   profiles/A create {username:'A', score:10, golden:0, clanId:null, updatedAt: request.time}            ALLOW
//   profiles/A merge-update {clanRole:'leader'} ALLOW; {username:'B'} DENY; {isAdmin:true} DENY; any delete DENY
//
// CLANS (signed in; "account" = Google/email, "anon" = anonymous). Start from a claimed clan C: ownerUid O, roles
// {O:'leader', K:'co-leader', E:'elder', M:'member'}, names for each, acct {O:true, K:true, E:true, M:true}, maxMembers 30.
//   create as account O {ownerUid:O, roles:{O:'leader'}, names:{O:'Olive'}, acct:{O:true}, clanXp:0, ...}           ALLOW
//   the same as anon, or with roles {O:'leader', X:'member'}, or clanXp 999                                       DENY
//   as X (anon) update roles.X='member', names.X='Xan', acct.X=false, members+['Xan']                             ALLOW (join)
//   as X update roles.X='co-leader' (straight in as co-leader), or roles.Y='member' (adding someone else)          DENY
//   as M update roles.M deleted, names.M deleted, acct.M deleted                                                   ALLOW (leave)
//   as O update roles.O deleted (the owner leaving without handing over)                                           DENY
//   as K update roles.M deleted (+names, acct, kicks.M) with act {by:K, kind:'kick', target:M}                     ALLOW
//   the same by E against K, or by M against E, or targeting O, or with act.target != M                            DENY
//   as O update roles.M='co-leader', act {by:O, kind:'role', target:M}                                            ALLOW
//   as K update roles.M='co-leader' (a co-leader making co-leaders), or roles.M='elder' without act                DENY
//   as O update ownerUid=K, roles.K='leader', roles.O='co-leader', owner='Cole'                                    ALLOW
//   as K update ownerUid=K (taking it), or as O handing it to an anonymous member                                  DENY
//   as O update name; as K update description; as M update clanXp + checkin                                         ALLOW
//   as K update name; as E update description; as M update owner or members only; as X (not a member) update clanXp DENY
//   delete as O ALLOW; as K DENY
// An OLD clan L (owner 'Olive', members ['Olive','Mia'], no ownerUid):
//   as account O update ownerUid=O, roles.O='leader', names.O='Olive', acct.O=true                                ALLOW (claim)
//   the same as anon, or with names.O='Mallory', or also changing clanXp                                           DENY
//   as anyone update owner='Mallory', or members=[] (the old takeover), or description                             DENY
//   as anyone update clanXp (shared progress, as before)                                                          ALLOW

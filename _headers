# HTTP security headers for the account page. Netlify (and Cloudflare Pages) read this file; other hosts ignore it.
# They stop other sites from showing the sign-in page inside a frame (clickjacking) and from guessing file types.
# Firebase's Google sign-in pop-up needs window.opener, so no Cross-Origin-Opener-Policy here.
/account
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/account.html
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/account.js
  X-Content-Type-Options: nosniff

/cloud.js
  X-Content-Type-Options: nosniff

# Installing the game as an app (pwa.js). The service worker must never be cached by the browser, or an update to it could
# take a day to reach players; the manifest needs its own content type.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache

# Pictures, sounds and icons change rarely and have no version in their names: browsers may keep them a day and keep using
# them for a week while they check for a newer copy in the background (scripts, styles and pages are always checked).
/mainimage/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/bgimages/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/PNG-cards-1.3/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
